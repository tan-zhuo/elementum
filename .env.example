# Absolute URL the site is served from, with a trailing slash.
#
# Used for the canonical link, Open Graph URLs, robots.txt and sitemap.xml — the
# only place a domain appears. Copy this file to `.env` (git-ignored) to point a
# build at a different deployment; the default in vite.config.ts is used otherwise.
VITE_SITE_URL=https://tan-zhuo.github.io/elementum/
